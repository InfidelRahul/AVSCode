<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background">

    <!-- VS Code Web View Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Terminal & Installation Pipeline Container -->
    <LinearLayout
        android:id="@+id/terminal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/terminal_background"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AVSCode — Linux Userspace"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/card_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="INITIALIZING"
                android:textColor="@color/terminal_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry"
                android:textColor="#ff5555"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hide_terminal"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editor"
                android:textColor="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <!-- Status Headline -->
        <TextView
            android:id="@+id/status_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:text="Checking environment..."
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <!-- Storage Permission Card (Shown when NEEDS_STORAGE_ACCESS) -->
        <LinearLayout
            android:id="@+id/storage_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/storage_access_title"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/storage_access_desc"
                android:textColor="#cccccc"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_grant_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/accent"
                android:text="@string/grant_storage_access" />
        </LinearLayout>

        <!-- Terminal Console View -->
        <ScrollView
            android:id="@+id/terminal_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0a0a0a"
            android:padding="8dp">

            <TextView
                android:id="@+id/terminal_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="AVSCode Terminal ready.\n"
                android:textColor="@color/terminal_text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <!-- CLI Command Input Bar (Available once Linux userspace is active) -->
        <LinearLayout
            android:id="@+id/cli_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="6dp"
                android:text="guest:$"
                android:textColor="@color/terminal_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/command_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:fontFamily="monospace"
                android:hint="Enter Linux command..."
                android:imeOptions="actionSend"
                android:inputType="text"
                android:padding="8dp"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_command"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/run_command"
                android:textColor="@color/accent" />
        </LinearLayout>

    </LinearLayout>

    <!-- Floating button to reopen Terminal when in Editor mode -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_show_terminal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/toggle_terminal"
        android:src="@android:drawable/ic_menu_agenda"
        app:backgroundTint="@color/card_background"
        app:tint="@color/terminal_secondary"
        android:visibility="gone" />

</FrameLayout>
